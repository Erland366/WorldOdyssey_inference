# Canonical runtime pins. The FastVideo section is legacy-only and is not used
# by the default one-command installer.
# Update these deliberately and rerun the model smoke tests before committing.

# Deprecated direct-FastVideo benchmark runtime.
WORLDODYSSEY_FASTVIDEO_VERSION=0.1.7
WORLDODYSSEY_FASTVIDEO_KERNEL_VERSION=0.2.2
WORLDODYSSEY_FASTVIDEO_TORCH_VERSION=2.11.0
WORLDODYSSEY_FASTVIDEO_TORCHVISION_VERSION=0.26.0
WORLDODYSSEY_FASTVIDEO_TORCHAUDIO_VERSION=2.11.0
WORLDODYSSEY_FASTVIDEO_DIFFUSERS_VERSION=0.39.0
WORLDODYSSEY_FASTVIDEO_HUGGINGFACE_HUB_VERSION=0.36.2
WORLDODYSSEY_HF_TRANSFER_VERSION=0.1.9

WORLDODYSSEY_SGLANG_VERSION=0.5.10.post1
# Cosmos 3 landed after the stable wheel above. The installer overlays this
# exact source revision while retaining the stable wheel's compiled CLI pieces.
WORLDODYSSEY_SGLANG_SOURCE_REV=9450696aa5dac5fd49a411786e164402fcdee9f5
WORLDODYSSEY_SGLANG_KERNEL_VERSION=0.4.3
WORLDODYSSEY_SGLANG_TORCH_VERSION=2.11.0
WORLDODYSSEY_SGLANG_TORCHVISION_VERSION=0.26.0
WORLDODYSSEY_SGLANG_TORCHAUDIO_VERSION=2.11.0
WORLDODYSSEY_SGLANG_TRANSFORMERS_VERSION=5.8.1
# PyPI's VSA wheel is built against an older Torch ABI. Build this exact
# official FastVideo source revision inside the unified SGLang environment.
WORLDODYSSEY_VSA_SOURCE_REV=055e52e5ea44b30cf982a3f248baa36ef386a39c

WORLDODYSSEY_COSMOS3_DIFFUSERS_REV=d5baa4fb548294f47dbca49890abd4b291204c60
WORLDODYSSEY_COSMOS3_GUARDRAIL_VERSION=0.3.1

# MiniMax-H3 requires the newer native conditions-based video API and CUDA 13
# dependency set. Keep it isolated so the validated FastWan/Cosmos CUDA 12
# runtime remains reproducible.
WORLDODYSSEY_MINIMAX_H3_SGLANG_VERSION=0.5.18
WORLDODYSSEY_MINIMAX_H3_TORCH_VERSION=2.13.0
WORLDODYSSEY_MINIMAX_H3_TRANSFORMERS_VERSION=5.12.1
WORLDODYSSEY_MINIMAX_H3_NINJA_VERSION=1.13.0
